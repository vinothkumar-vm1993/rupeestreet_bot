# ==========================================
# TITAN ALPHA X // TELEGRAM BOT CONFIG
# ==========================================

# 1. Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# 2. Authorized Telegram User IDs (comma separated, e.g. 12345678,98765432)
# Leave blank to allow anyone who talks to the bot, or set your ID from @userinfobot to secure it
AUTHORIZED_USER_IDS=

# 3. Default Chat ID for broadcast alerts
DEFAULT_CHAT_ID=

# 4. Log Level (INFO, DEBUG, WARNING, ERROR)
LOG_LEVEL=INFO
